# ── QualityOps Lab — local environment template ────────────────────────────────
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env
#
# ⚠  .env is git-ignored and must NEVER be committed.
# ⚠  These are LOCAL DEVELOPMENT defaults only.
#    Use a secrets manager (Azure Key Vault, etc.) in production.

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_DB=qualityops
POSTGRES_USER=qualityops
POSTGRES_PASSWORD=qualityops

# ── API (optional overrides) ────────────────────────────────────────────────────
# Uncomment and set a strong secret for local JWT signing.
# The default in application.yml is a safe dev-only placeholder.
# JWT_SECRET=<base64-encoded-256-bit-secret>

# ── MinIO (test-artifact object store, ADR-005) ────────────────────────────────
# Root pair — used only by the minio-bootstrap one-shot, never by an app.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Dev-only built-in KMS key so SSE-S3 PUTs succeed without a separate KES service.
MINIO_KMS_SECRET_KEY=qualityops-key:SRQ1GITaFoeyk14g0b5x+if/Fph5CjoSRfT1Bs7ipx0=
# Write-only credential the Worker uses (s3:PutObject + s3:GetObject on the bucket).
MINIO_RW_USER=qualityops-artifacts-rw
MINIO_RW_PASSWORD=qualityops-artifacts-rw-secret
# Read-only credential the API uses to presign artifact GET URLs (s3:GetObject only).
MINIO_RO_USER=qualityops-artifacts-ro
MINIO_RO_PASSWORD=qualityops-artifacts-ro-secret

# ── Worker secretRef demo ─────────────────────────────────────────────────────
# Resolved at execution time for a browser FILL / API Authorization secretRef.
QUALITYOPS_SECRET_DEMO_PASSWORD=hunter2

# ── Gateway TLS (staging profile only — ADR-008 §8) ───────────────────────────
# Inert unless SPRING_PROFILES_ACTIVE=staging. Terminating TLS at an LB/ingress?
# set GATEWAY_TLS_ENABLED=false and keep SERVER_PORT=8090. See
# docs/runbooks/https-staging.md.
GATEWAY_TLS_ENABLED=true
GATEWAY_TLS_KEYSTORE=file:/etc/qualityops/tls/keystore.p12
GATEWAY_TLS_KEYSTORE_PASSWORD=
GATEWAY_TLS_KEY_ALIAS=qualityops-gateway

# ── CI security scanning (optional) ──────────────────────────────────────────
# NVD API key removes the OWASP Dependency-Check anonymous rate limit.
# CI reads it from the NVD_API_KEY repo secret; unset locally is fine (slower).
# NVD_API_KEY=

# ── Repository-owned framework execution (ADR-009, Phase 2F) ──────────────────
# Kill switch — both the API (preflight/allowlist) and the Worker (the
# RepositoryExecutionRunner) read this.
QUALITYOPS_REPO_EXEC_ENABLED=true

# Digest-pinned runner-image allowlist. Defaults live in application.yml and in
# infra/compose/runner-images.env (the single source of truth); override here
# only to test a re-pinned digest locally. Never hand-edit a digest — re-pull
# and re-inspect (see infra/compose/runner-images.env's header comment).
# QUALITYOPS_REPO_IMAGE_PLAYWRIGHT=mcr.microsoft.com/playwright:v1.55.0-jammy@sha256:<pin>
# QUALITYOPS_REPO_IMAGE_JUNIT=maven:3.9-eclipse-temurin-21@sha256:<pin>
# QUALITYOPS_REPO_IMAGE_PYTEST=python:3.12-slim@sha256:<pin>
# QUALITYOPS_REPO_IMAGE_CYPRESS=cypress/included:13.15.0@sha256:<pin>
# QUALITYOPS_REPO_IMAGE_K6=grafana/k6:0.54.0@sha256:<pin>
# QUALITYOPS_REPO_IMAGE_CHECKOUT=alpine/git:2.45.2@sha256:<pin>

# The Worker's Docker Remote API endpoint. In compose this is the verb-
# allowlisted docker-proxy (tecnativa/docker-socket-proxy) — never the raw host
# socket. require-proxy=true fails Worker startup if this resolves to a raw
# unix socket; a raw socket is accepted only for local
# `mvn -pl apps/worker spring-boot:run` outside compose (loud WARN).
DOCKER_HOST=tcp://docker-proxy:2375
REPO_EXEC_REQUIRE_PROXY=true

# SCM credential fixture for the demo repository connection — an opaque
# credentialRef key, resolved by both the API (ref-resolution / "test
# connection") and the Worker (checkout git fetch) from
# QUALITYOPS_SCM_CREDENTIAL_<KEY>. A public demo repo needs no token: leave
# blank. Never a provider PAT for a real account in this file.
QUALITYOPS_SCM_CREDENTIAL_DEMO=
