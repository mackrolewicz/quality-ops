{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(java -version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(docker --version)",
      "Bash(docker compose:*)",
      "Bash(cd apps/api && ./mvnw:*)",
      "Bash(cd apps/worker && ./mvnw:*)",
      "Bash(cd apps/gateway && ./mvnw:*)",
      "Bash(cd apps/web && npm:*)",
      "Bash(cd apps/web && npx:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git clean:*)",
      "Bash(docker build:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(docker push:*)",
      "Bash(kubectl delete:*)"
    ]
  },
  "env": {
    "SPRING_PROFILES_ACTIVE": "local",
    "JAVA_HOME_HINT": "Requires Java 21+",
    "NODE_VERSION_HINT": "Requires Node 20+"
  }
}