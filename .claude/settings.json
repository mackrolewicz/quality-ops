{
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(ls:*)",
      "Bash(java -version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(docker --version)",
      "Bash(docker compose:*)",
      "Bash(cd apps/api && ./mvnw:*)",
      "Bash(cd apps/worker && ./mvnw:*)",
      "Bash(cd apps/gateway && ./mvnw:*)",
      "Bash(cd apps/web && npm:*)",
      "Bash(cd apps/web && npx:*)"
    ],
    "ask": [
      "Edit(**)",
      "Write(**)",
      "Bash(git:*)",
      "Bash(docker build:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(docker push:*)",
      "Bash(kubectl delete:*)"
    ]
  },
  "env": {
    "SPRING_PROFILES_ACTIVE": "local",
    "JAVA_HOME_HINT": "Requires Java 21+",
    "NODE_VERSION_HINT": "Requires Node 20+"
  }
}
