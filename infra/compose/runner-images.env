# ADR-009 §5/§12 — the digest-pinned runner-image allowlist. This is the single
# source of truth for the six refs baked as defaults into
# apps/api/src/main/resources/application.yml (RepoExecApiProperties) and
# apps/worker/src/main/resources/application.yml (RepoExecWorkerProperties),
# and for the CI Trivy scan matrix (.github/workflows/ci.yml).
#
# Every digest below was resolved for REAL — `docker pull <image>:<tag>` then
# `docker inspect <image>:<tag> --format '{{json .RepoDigests}}'` — exactly how
# AbstractDockerRunnerIT.bootOnce() resolves alpine/git's pinned ref for the
# worker's docker-tagged ITs. Never hand-edit a digest: bump the tag, re-pull,
# re-inspect, paste the new digest. `DockerContainerRunner.verifyDigest` /
# `RepoImageAllowlistTest` require an exact `<repo>@sha256:<digest>` match.
#
# Resolved on 2026-09-04 (linux/amd64, this dev box's Docker Desktop).
# CODEOWNERS-guarded — see .github/CODEOWNERS.

QUALITYOPS_REPO_IMAGE_PLAYWRIGHT=mcr.microsoft.com/playwright:v1.55.0-jammy@sha256:55db7b712a981e9cc1ec757a4511cd01c5ed4e20bd7c84b2dee4e1d320102b9d
QUALITYOPS_REPO_IMAGE_JUNIT=maven:3.9-eclipse-temurin-21@sha256:8f6ac126f7810bb5549c4cd122d2bf0e9cda5bdeb0838aa928f09e779fd8bef8
