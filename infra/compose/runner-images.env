# ADR-009 §5/§12 — the digest-pinned runner-image allowlist. This is the single
# source of truth for the six refs baked as defaults into
# apps/api/src/main/resources/application.yml (RepoExecApiProperties) and
# apps/worker/src/main/resources/application.yml (RepoExecWorkerProperties),
# and for the CI Trivy scan matrix (.github/workflows/ci.yml).
#
# Every digest below was resolved for REAL, never hand-written. Two equivalent
# ways to re-resolve one (both yield the manifest-list/index digest, which is
# what `.RepoDigests` reports and what these refs pin):
#
#   docker pull <image>:<tag>
#   docker inspect <image>:<tag> --format '{{json .RepoDigests}}'
#
#   # or, with no Docker daemon — read Docker-Content-Digest off the registry:
#   TOKEN=$(curl -s "https://auth.docker.io/token?service=registry.docker.io\
# &scope=repository:<repo>:pull" | jq -r .token)
#   curl -sI -H "Authorization: Bearer $TOKEN" \
#     -H "Accept: application/vnd.oci.image.index.v1+json,\
# application/vnd.docker.distribution.manifest.list.v2+json" \
#     "https://registry-1.docker.io/v2/<repo>/manifests/<tag>" \
#     | grep -i docker-content-digest
#
# Never hand-edit a digest: bump the tag, re-resolve, paste the new digest.
# `DockerContainerRunner.verifyDigest` / `RepoImageAllowlistTest` require an
# exact `<repo>@sha256:<digest>` match.
#
# 2026-09-04 — initial six, resolved via docker pull/inspect (linux/amd64).
# 2026-09-05 — playwright, cypress, k6 and checkout re-pinned to clear the
#   base-OS HIGH/CRITICAL findings that failed CI's runner-image-scan. The scan
#   runs with `ignore-unfixed: true`, so every one of those findings had a fix
#   published upstream — they are FIXED by moving the pin, never suppressed in
#   .trivyignore. Re-resolved via the registry API above (Docker Desktop was
#   unavailable); the method was validated by reproducing all three of the
#   then-current Docker Hub digests byte-for-byte before any tag was changed.
#   k6 deliberately goes to the newest 1.x, NOT 2.x: `--summary-export`, which
#   K6SummaryReportParser reads, is deprecated-but-present through 1.x and
#   removed in 2.x. Any future k6 major bump must land with a parser change.
# CODEOWNERS-guarded — see .github/CODEOWNERS.

QUALITYOPS_REPO_IMAGE_PLAYWRIGHT=mcr.microsoft.com/playwright:v1.59.1-jammy@sha256:8a0360d39d1973be506dd59002904a774f6d697d4946c94063b3fd006461c8ff
