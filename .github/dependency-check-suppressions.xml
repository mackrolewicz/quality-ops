<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppression file (ADR-008 §9).

  RULES (enforced by review; this file is CODEOWNERS-guarded):
    * Time-boxed suppressions ONLY. Every <suppress> element MUST carry an
      `until="YYYY-MM-DDZ"` attribute.
    * Every entry MUST have a comment stating: the CVE, WHY it does not apply to
      this project, a linked issue, and the review date.
    * No blanket suppressions. No severity downgrades. A real advisory is either
      fixed or explicitly, reviewably suppressed here.

  Example (do not leave uncommented):
  <suppress until="2026-12-31Z">
    <notes><![CDATA[
      CVE-0000-00000 — false positive: the vulnerable code path (X) is not
      reachable because Y. Tracked in #123. Review by 2026-12-31.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/com\.example/thing@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
